      "LOGO.jpg",
      "manifest.webmanifest",
      "sw.js",
      "electron-main.cjs"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
