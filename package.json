{
  "name": "teixeira-gestao-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "build": {
    "appId": "br.com.teixeira.gestao",
    "asar": false,
    "productName": "Teixeira Gestão",
    "files": [
      "index.html",
